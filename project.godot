; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="soln"
run/main_scene="res://scenes/main_menu/start_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/image="res://assets/background/Lighthouse_loading screen.png"
boot_splash/fullsize=false
config/icon="res://icon.svg"
config/windows_native_icon="res://icon.ico"

[autoload]

GlobalFractionFunctions="*res://scripts/global_scripts/global_fraction_functions.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
PlayerState="*res://helpers/player_state.gd"
Global="*res://helpers/global.gd"
DialogueState="*res://helpers/dialogue_state.gd"
QuestionsLoader="*res://helpers/questions_loader.gd"
Statistics="*res://helpers/statistics.gd"
SaveState="*res://helpers/save_state.gd"

[dialogue_manager]

general/states=["State", "DialogueState", "PlayerState", "Global"]
general/custom_test_scene_path="res://dialogue/dialogue_tester/TestDialogue.tscn"
general/balloon_path="res://dialogue/dialogue_balloon/balloon.tscn"

[display]

window/size/viewport_width=1024
window/size/viewport_height=576
window/size/mode=3
window/size/resizable=false
window/stretch/mode="viewport"
mouse_cursor/custom_image="res://assets/ui/Mouse Cursor.png"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/gdUnit4/plugin.cfg")

[gui]

theme/custom_font="res://dialogue/terminal-grotesque.ttf"

